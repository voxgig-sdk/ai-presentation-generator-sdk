# Entity: presentation

main: kit: entity: presentation: {

  alias: field: {}

  fields: [
    {
      name: "colorScheme"
      req: false
      short: "Primary color scheme for the presentation"
      type: "`$STRING`"
    }
    {
      name: "content"
