          "content": {
            "application/json": {
              "examples": {
                "basicPresentation": {
                  "summary": "Basic presentation example",
                  "value": {
                    "content": "Introduction to AI Technology",
                    "layout": "professional",
                    "slides": 10,
                    "theme": "modern",
                    "topic": "Artificial Intelligence"
                  }
                },
                "detailedPresentation": {
                  "summary": "Detailed presentation with outline",
                  "value": {
                    "content": "Quarterly Business Review: Sales increased by 25%, new product launches successful, expanding to 3 new markets",
